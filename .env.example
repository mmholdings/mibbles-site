# ────────────────────────────────────────────────────────────────
# Public — exposed to the browser
# ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-app.up.railway.app
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/mibbles/idXXXXXXXXX
NEXT_PUBLIC_APP_STORE_ID=XXXXXXXXX
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# ────────────────────────────────────────────────────────────────
# Supabase — newsletter / waitlist backend
# ────────────────────────────────────────────────────────────────
# Both come from Supabase → Project Settings → API.
# SERVICE_ROLE_KEY is secret and must NEVER be exposed to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ────────────────────────────────────────────────────────────────
# Server-only — optional for the first deploy
# ────────────────────────────────────────────────────────────────

# Blog automation cron (GitHub Actions reads this from GitHub Secrets, not Railway)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Contact form sender (optional — falls back to console.log if missing)
RESEND_API_KEY=

# Admin dashboard (basic auth) — change before first deploy
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please
